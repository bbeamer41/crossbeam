set -e

if ! getent group crossbeam >/dev/null 2>&1; then
	groupadd --system crossbeam
fi
if ! getent passwd crossbeam >/dev/null 2>&1; then
	useradd --system --home /var/lib/crossbeam --shell /usr/sbin/nologin --gid crossbeam crossbeam
fi
if [ -L /var/lib/crossbeam ]; then
	echo "crossbeam: state directory is a symlink" >&2
	exit 1
fi
if [ -e /var/lib/crossbeam ] && [ ! -d /var/lib/crossbeam ]; then
	echo "crossbeam: state path is not a directory" >&2
	exit 1
fi
install -d -o crossbeam -g crossbeam -m 0700 /var/lib/crossbeam
# An existing tree is given to this account. -h does not follow a link.
chown -h -R crossbeam:crossbeam /var/lib/crossbeam
if getent group dialout >/dev/null 2>&1; then
	usermod -a -G dialout crossbeam
fi
if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
	systemctl daemon-reload || true
fi
exit 0
