[Unit]
Description=Crossbeam packet node
Wants=modprobe@cdc_acm.service modprobe@ftdi_sio.service modprobe@cp210x.service modprobe@ch341.service modprobe@pl2303.service
After=network.target modprobe@cdc_acm.service modprobe@ftdi_sio.service modprobe@cp210x.service modprobe@ch341.service modprobe@pl2303.service

[Service]
Type=simple
User=crossbeam
Group=crossbeam
SupplementaryGroups=dialout
StateDirectory=crossbeam
StateDirectoryMode=0700
RuntimeDirectory=crossbeam
RuntimeDirectoryMode=0750
UMask=0077
ExecStart=/usr/local/bin/crossbeam serve --state /var/lib/crossbeam --socket /run/crossbeam/crossbeam.sock --socket-mode 0660
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=78
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/crossbeam
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
