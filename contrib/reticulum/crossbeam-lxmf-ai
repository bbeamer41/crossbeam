"""Crossbeam LXMF bridge for the AI assistant.

This is a separate program. Crossbeam does not speak Reticulum, so this
bridge receives LXMF messages sent to the station, passes each one to the
running Crossbeam over its local ai.sock, and sends Crossbeam's reply back
over LXMF. Crossbeam decides what to answer: only messages that start
with AI, only while ai.enabled and ai.reticulum are on, with the same
limits, filter, and log as packet. See docs/ai.md.

Needs the Reticulum and LXMF Python packages: pip install rns lxmf

Only an LXMF message whose signature validates is answered. An unsigned
message and a message with a bad signature are dropped.
"""

import argparse
import concurrent.futures
import json
import os
import socket
import sys
import threading
import time

try:
    import RNS
    import LXMF
except ImportError:
    RNS = None
    LXMF = None

APP_NAME = "crossbeam-lxmf-ai"

# LXMF.LXMessage.SIGNATURE_INVALID. Kept here so a test can run without
# the Reticulum packages installed.
SIGNATURE_INVALID = 0x02

# Crossbeam answers two questions at once and tells the next caller the
# server is busy. Keep more workers than that so the extra caller reaches
# Crossbeam and hears it, instead of waiting here and being answered
# late. The cap still stops a burst from growing the queue without bound.
BRIDGE_WORKERS = 8


def is_ai_command(text):
    """True when the first word is AI, the same rule as Crossbeam.

    A word that only begins with those letters, such as AIRPLANE, is not
    a command and is not sent to the socket.
    """
    if not isinstance(text, str):
        return False
    parts = text.split()
    return bool(parts) and parts[0].upper() == "AI"


def store_private(path, write):
    """Run write(path) so the file is created mode 0600.

    The writer may open the file with the process umask. A private key
    must not be world-readable in that moment, so the umask is 077 for
    the write and the mode is set again afterwards.
    """
    old = os.umask(0o077)
    try:
        write(path)
    finally:
        os.umask(old)
    os.chmod(path, 0o600)


def signature_accepted(signature_validated, unverified_reason, invalid_reason=SIGNATURE_INVALID):
    """True only when the sender's signature validates.

    An unsigned message leaves signature_validated false. A bad signature
    sets unverified_reason to SIGNATURE_INVALID.
    """
    if unverified_reason == invalid_reason:
        return False
    return signature_validated is True


def log(msg):
    if RNS is None:
        print(f"[{APP_NAME}] {msg}", file=sys.stderr)
        return
    RNS.log(f"[{APP_NAME}] {msg}", RNS.LOG_NOTICE)


def ask_crossbeam(path, sender_hex, text, timeout):
    """Send one message to Crossbeam and return its reply, or None."""
    req = json.dumps({"from": sender_hex, "text": text}) + "\n"
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(timeout)
        s.connect(path)
        s.sendall(req.encode("utf-8"))
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(4096)
            if not chunk:
                break
            buf += chunk
            if len(buf) > 64 * 1024:
                raise ValueError("reply too long")
    out = json.loads(buf.decode("utf-8"))
    if out.get("error"):
        log(f"Crossbeam refused a request: {out['error']}")
        return None
    if out.get("ignore"):
        return None
    return out.get("reply") or None


class Bridge:
    def __init__(self, args):
        self.args = args
        self.reticulum = RNS.Reticulum(configdir=args.rnsconfig)
        os.makedirs(args.storage, mode=0o700, exist_ok=True)
        try:
            os.chmod(args.storage, 0o700)
        except OSError as e:
            log(f"could not set the storage directory mode: {e}")
        id_path = os.path.join(args.storage, "identity")
        if os.path.isfile(id_path):
            self.identity = RNS.Identity.from_file(id_path)
            os.chmod(id_path, 0o600)
        else:
            self.identity = RNS.Identity()
            store_private(id_path, self.identity.to_file)
        self.router = LXMF.LXMRouter(identity=self.identity, storagepath=args.storage)
        self.dest = self.router.register_delivery_identity(self.identity, display_name=args.name)
        # The pool exists before the callback. A delivery can arrive as
        # soon as the callback is registered.
        self.room = threading.BoundedSemaphore(BRIDGE_WORKERS)
        self.pool = concurrent.futures.ThreadPoolExecutor(max_workers=BRIDGE_WORKERS)
        self.router.register_delivery_callback(self.received)
        log(f"LXMF address {RNS.prettyhexrep(self.dest.hash)} as {args.name!r}")

    def announce_loop(self):
        while True:
            self.router.announce(self.dest.hash)
            log("announced")
            time.sleep(self.args.announce)

    def received(self, message):
        reason = getattr(message, "unverified_reason", None)
        invalid = LXMF.LXMessage.SIGNATURE_INVALID
        if not signature_accepted(getattr(message, "signature_validated", False), reason, invalid):
            if reason == invalid:
                log("dropped a message with a bad signature")
            else:
                log("dropped an unsigned message")
            return
        try:
            text = message.content_as_string() or ""
        except Exception:
            return
        # Same first-word rule as Crossbeam. Anything else is ignored
        # here so it does not take a worker.
        if not is_ai_command(text):
            return
        if not self.room.acquire(blocking=False):
            log("dropped a message because the bridge is already busy")
            return
        try:
            self.pool.submit(self.answer_limited, message.source_hash, text)
        except RuntimeError:
            self.room.release()
            raise

    def answer_limited(self, source_hash, text):
        try:
            self.answer(source_hash, text)
        finally:
            self.room.release()

    def recall(self, source_hash):
        ident = RNS.Identity.recall(source_hash)
        if ident is not None:
            return ident
        RNS.Transport.request_path(source_hash)
        deadline = time.time() + self.args.path_wait
        while time.time() < deadline:
            time.sleep(0.5)
            ident = RNS.Identity.recall(source_hash)
            if ident is not None:
                return ident
        return None

    def answer(self, source_hash, text):
        sender = source_hash.hex()
        try:
            reply = ask_crossbeam(self.args.socket, sender, text, self.args.timeout)
        except Exception as e:
            log(f"Crossbeam is not answering on {self.args.socket}: {e}")
            return
        if not reply:
            return
        ident = self.recall(source_hash)
        if ident is None:
            log(f"no path to {RNS.prettyhexrep(source_hash)}; reply dropped")
            return
        out = RNS.Destination(ident, RNS.Destination.OUT, RNS.Destination.SINGLE, "lxmf", "delivery")
        method = LXMF.LXMessage.DIRECT if self.args.method == "direct" else LXMF.LXMessage.OPPORTUNISTIC
        msg = LXMF.LXMessage(out, self.dest, reply, title="", desired_method=method)
        self.router.handle_outbound(msg)


def main():
    if RNS is None or LXMF is None:
        print("crossbeam-lxmf-ai: install the rns and lxmf packages", file=sys.stderr)
        return 1
    p = argparse.ArgumentParser(description="Answer LXMF messages with the Crossbeam AI assistant.")
    p.add_argument("--socket", default="/run/crossbeam/ai.sock", help="Crossbeam AI bridge socket (default %(default)s)")
    p.add_argument("--storage", default=os.path.expanduser("~/.crossbeam-lxmf-ai"), help="identity and LXMF storage directory")
    p.add_argument("--rnsconfig", default=None, help="Reticulum config directory (default: the usual ~/.reticulum)")
    p.add_argument("--name", default="Crossbeam AI", help="display name in announces, such as 'N0CALL AI'")
    p.add_argument("--announce", type=int, default=1800, help="seconds between announces (default %(default)s)")
    p.add_argument("--method", choices=["direct", "opportunistic"], default="direct", help="how replies are sent")
    p.add_argument("--timeout", type=int, default=660, help="seconds to wait for Crossbeam (default %(default)s)")
    p.add_argument("--path-wait", type=int, default=20, help="seconds to wait for a path to an unknown sender")
    args = p.parse_args()
    if args.announce < 60:
        p.error("--announce must be at least 60 seconds")
    bridge = Bridge(args)
    threading.Thread(target=bridge.announce_loop, daemon=True).start()
    try:
        while True:
            time.sleep(3600)
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
